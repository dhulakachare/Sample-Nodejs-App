name: Build and Publish Docker Image
on: 
  workflow_dispatch:

jobs:
  build_publish_images:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
      - name: Build Docker Image
        run: |
          docker build -t sample-nodejs-app:latest .
      - name: Push Docker Image to DockerHub
        run: |  
          echo "${{ secrets.DOCKERHUB_TOKEN }}" | docker login -u "${{ secrets.DOCKER_USERNAME }}" --password-stdin
          docker tag sample-nodejs-app:latest ${{ secrets.DOCKER_USERNAME }}/sample-nodejs-app:latest
          docker push ${{ secrets.DOCKER_USERNAME }}/sample-nodejs-app:latest      